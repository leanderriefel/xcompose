{
  "name": "xcompose",
  "version": "0.2.1",
  "description": "Minimal AI writing assistant for X/Twitter compose — fix grammar, shorten, punchier. Bring your own key (OpenAI, Anthropic, OpenRouter, OpenCode).",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && vite build --mode firefox",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --type-aware",
    "lint:fix": "oxlint src --fix --type-aware",
    "format": "oxfmt --check src",
    "format:fix": "oxfmt src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "zip": "node scripts/zip.mjs",
    "zip:firefox": "node scripts/zip.mjs --firefox",
    "assets": "node scripts/store-assets.mjs",
    "package": "pnpm check && pnpm test && pnpm build && pnpm build:firefox && pnpm validate:firefox && pnpm zip && pnpm zip:firefox && pnpm zip:source",
    "test": "vitest run",
    "validate:firefox": "node scripts/validate-firefox.mjs",
    "zip:source": "node scripts/zip.mjs --source",
    "release": "node scripts/release.mjs",
    "test:manual": "vite --config tests/vite.config.mjs"
  },
  "keywords": [
    "x",
    "twitter",
    "extension",
    "ai",
    "writing",
    "grammar"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/openai": "^4.0.52",
    "@ai-sdk/openai-compatible": "^3.0.42",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@kobalte/core": "^0.13.13",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.85",
    "solid-js": "^1.9.15",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "draft-js": "0.11.7",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0"
  }
}
